name: CI

# Fast, blocking quality gate: formatting, lints, tests, and a release build.
# Runs on every push/PR to main. Heavy benchmarking lives in benchmark.yml.

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
  workflow_dispatch:

concurrency:
  group: ci-${{ github.ref }}
  cancel-in-progress: true

env:
  CARGO_TERM_COLOR: always
  RUST_BACKTRACE: 1

jobs:
  fmt:
    name: fmt
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: rustfmt
      - name: cargo fmt --check
        run: cargo fmt --all --check

  clippy:
    name: clippy
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
        with:
          components: clippy
      - uses: Swatinem/rust-cache@v2
      - name: cargo clippy --all-targets
        # Not `-D warnings` yet: the tree still carries ~200 warnings
        # (dead code / unused imports) tracked as P2 debt. This gate fails on
        # real lint errors but does not block on the existing warning backlog.
        run: cargo clippy --all-targets
      - name: foundation crates clippy -D warnings
        # Blueprint Phase A: new organization crates must stay warning-clean.
        run: >
          cargo clippy
          -p jhol-graph -p jhol-adapters -p jhol-receipt -p jhol-policy
          -p jhol-task -p jhol-env -p jhol-diff -p jhol-ai -p jhol-db
          -p jhol-remote
          --all-targets -- -D warnings

  foundation:
    name: blueprint foundation
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Foundation crate tests
        run: >
          cargo test
          -p jhol-graph -p jhol-adapters -p jhol-receipt -p jhol-policy
          -p jhol-task -p jhol-env -p jhol-diff -p jhol-ai -p jhol-db
          -p jhol-remote
          --lib
      - name: Build jhol binary
        run: cargo build --bin jhol
      - name: Blueprint verify.sh
        run: examples/blueprint/verify.sh
      - name: CLI help matches dispatch
        run: |
          set -euo pipefail
          HELP="$(./target/debug/jhol --help)"
          for cmd in plan diff sync snapshot restore db ai dev; do
            grep -qE "^[[:space:]]+${cmd}[[:space:]]" <<<"$HELP"
          done
          DBHELP="$(./target/debug/jhol db --help)"
          grep -q plan <<<"$DBHELP"
          grep -q probe <<<"$DBHELP"
          AIHELP="$(./target/debug/jhol ai --help)"
          grep -q verify <<<"$AIHELP"
          ./target/debug/jhol plan --help >/dev/null
          ./target/debug/jhol sync --help >/dev/null

  adapter-smoke:
    name: real adapter dependencies (${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    permissions:
      contents: read
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - name: Install uv
        uses: astral-sh/setup-uv@bec219d24cd3e171d82865faccec33120bb574f4 # v10.1.0
        with:
          version: "0.11.16"
      - name: Build jhol
        run: cargo build --bin jhol
      - name: Verify real JS, Python and Rust dependencies
        working-directory: examples/blueprint
        run: uv run --python 3.12 --no-project --quiet python verify_online.py

  test:
    name: test (${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Build
        run: cargo build
      - name: Test
        run: cargo test
      - name: Test install front door and prepared-tree proof
        run: cargo test -p jhol-trampoline

  package-manager-windows:
    name: package manager correctness (windows-latest)
    runs-on: windows-latest
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Test package manager core
        run: cargo test -p jhol-core --lib
      - name: Test install front door and prepared-tree proof
        run: cargo test -p jhol-trampoline

  release-build:
    name: release build (${{ matrix.os }})
    strategy:
      fail-fast: false
      matrix:
        os: [ubuntu-latest, macos-latest, windows-latest]
    runs-on: ${{ matrix.os }}
    steps:
      - uses: actions/checkout@v4
      - uses: dtolnay/rust-toolchain@stable
      - uses: Swatinem/rust-cache@v2
      - name: Build release binary
        run: cargo build --release --bin jhol
      - name: Smoke test (--version)
        shell: bash
        run: |
          if [ -f target/release/jhol ]; then
            ./target/release/jhol --version
          else
            ./target/release/jhol.exe --version
          fi
