        );
        assert_eq!(
            super::DaemonCache::lookup_for_origin(name, true, "https://a.example", Some("token-a")),
            Some(b"one".to_vec())
        );
        assert_eq!(
            super::DaemonCache::lookup_for_origin(name, true, "https://b.example", Some("token-a")),
            Some(b"two".to_vec())
        );
    }

    use super::*;

    #[test]
    fn pre_clap_skip_accepts_only_plain_install_aliases() {
        let args = |values: &[&str]| {
            values
                .iter()
                .map(std::ffi::OsString::from)
                .collect::<Vec<_>>()
        };
        assert!(is_plain_install_before_clap(&args(&["install"])));
        assert!(is_plain_install_before_clap(&args(&["i"])));
        assert!(!is_plain_install_before_clap(&args(&["ci"])));
        assert!(!is_plain_install_before_clap(&args(&[
            "install", "--frozen"
        ])));
        assert!(!is_plain_install_before_clap(&args(&["install", "react"])));
        assert!(!is_plain_install_before_clap(&args(&[])));
    }

    /// A request whose bytes do not carry the protocol magic must be rejected, not
    /// acted on. The handler read the struct raw and never checked it.
    #[test]
    fn request_magic_is_validated() {
        let good = DaemonRequest::new(
            "/tmp",
            &["ms@2.1.3".to_string()],
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            true,
        );
        assert!(good.has_valid_magic());
        let mut bad = DaemonRequest::new(
            "/tmp",
            &[],
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            true,
        );
        bad.magic = *b"NOTJHLR\0";
        assert!(!bad.has_valid_magic());
    }

    /// `pkg_count` arrives off the wire, so a hostile value must never be trusted as a
    /// pre-allocation: `Vec::with_capacity(u32::MAX)` reserves ~96 GB and the release
    /// profile aborts on allocation failure. Asserted through the clamp so the test
    /// itself cannot allocate it.
    #[test]
    fn hostile_pkg_count_is_clamped_before_allocating() {
        let capped = crate::utils::clamp_prealloc(u32::MAX as usize).min(DAEMON_MAX_PKGS);
        assert_eq!(capped, DAEMON_MAX_PKGS);
        // A real request still round-trips its packages.
        let req = DaemonRequest::new(
            "/tmp",
            &["a@1.0.0".to_string(), "b@2.0.0".to_string()],
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            true,
        );
        assert_eq!(req.packages(), vec!["a@1.0.0", "b@2.0.0"]);
    }

    #[test]
    fn request_constructor_rejects_fields_that_would_be_truncated() {
        let too_many = vec!["x".to_string(); DAEMON_MAX_PKGS + 1];
        assert!(DaemonRequest::try_new(
            "/tmp", &too_many, false, false, false, false, false, false, false, false, false,
        )
        .is_err());

        let too_long = vec!["x".repeat(DAEMON_PKG_NAME_LEN)];
        assert!(DaemonRequest::try_new(
            "/tmp", &too_long, false, false, false, false, false, false, false, false, false,
        )
        .is_err());
        assert!(DaemonRequest::try_new(
            &"x".repeat(DAEMON_CWD_LEN),
            &[],
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
        )
        .is_err());
        assert!(DaemonRequest::try_new(
            "/tmp\0elsewhere",
            &[],
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
        )
        .is_err());

        // Keep the old constructor source-compatible, but make its invalid result
        // impossible to write as a valid request.
        let invalid = DaemonRequest::new(
            &"x".repeat(DAEMON_CWD_LEN),
            &[],
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
        );
        let mut wire = Vec::new();
        assert!(write_request(&mut wire, &invalid).is_err());
        assert!(wire.is_empty());
    }

    #[test]
    fn request_reader_rejects_invalid_magic_and_hostile_fields() {
        fn wire_bytes(request: &DaemonRequest) -> Vec<u8> {
            let ptr = request as *const DaemonRequest as *const u8;
            unsafe { std::slice::from_raw_parts(ptr, DAEMON_REQUEST_SIZE).to_vec() }
        }

        let mut invalid_magic = DaemonRequest::try_new(
            "/tmp",
            &[],
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
        )
        .unwrap();
        invalid_magic.magic = *b"BADREQ\0\0";
        let error = read_request(&mut std::io::Cursor::new(wire_bytes(&invalid_magic)))
            .err()
            .expect("invalid magic must be rejected");
        assert_eq!(error.kind(), std::io::ErrorKind::InvalidData);

        let mut excessive_count = DaemonRequest::try_new(
            "/tmp",
            &[],
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
        )
        .unwrap();
        excessive_count.pkg_count = (DAEMON_MAX_PKGS + 1) as u32;
        let error = read_request(&mut std::io::Cursor::new(wire_bytes(&excessive_count)))
            .err()
            .expect("over-limit package count must be rejected");
        assert_eq!(error.kind(), std::io::ErrorKind::InvalidData);

        let mut invalid_package = DaemonRequest::try_new(
            "/tmp",
            &["pkg".to_string()],
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
            false,
        )
        .unwrap();
        invalid_package.pkgs[0][0] = 0xff;
        assert!(invalid_package.validate().is_err());
    }

    #[test]
    fn daemon_connection_permits_are_bounded_and_released() {
        let permits: Vec<_> = (0..DAEMON_MAX_CONNECTIONS)
            .map(|_| try_daemon_connection_permit().expect("permit below the limit"))
            .collect();
        assert!(try_daemon_connection_permit().is_none());
        drop(permits);
        assert!(try_daemon_connection_permit().is_some());
    }

    /// The wire sizes must stay exactly the struct sizes: `read_exact`/`from_raw_parts`
    /// rely on them, so a mismatch would be undefined behaviour rather than a bug.
    #[test]
    fn wire_sizes_match_the_structs() {
        assert_eq!(DAEMON_REQUEST_SIZE, std::mem::size_of::<DaemonRequest>());
        assert_eq!(DAEMON_RESPONSE_SIZE, std::mem::size_of::<DaemonResponse>());
    }
