/// What one instruction produced.
#[derive(Debug)]
enum Step {
    Continue,
    Done(Value),
    Yield(Value),
}

/// A suspended generator: its bytecode plus a snapshot of its register file.
#[derive(Debug)]
pub struct GenState {
    proto: Arc<FnProto>,
    regs: Vec<Value>,
    ip: usize,
    started: bool,
    done: bool,
    this_val: Value,
}

