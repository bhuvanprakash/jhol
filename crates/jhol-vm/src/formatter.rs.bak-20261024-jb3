//! `jhol fmt` for JavaScript, driven by JholVM's own parser.
//!
//! Why this exists: the previous formatter piped JS through a third-party
//! code generator and then patched the result textually, which corrupted
//! `async (a, b) => {}` into invalid code and exploded every short array
//! literal across one element per line. Formatting the AST we already parse
//! removes the whole class of bug, and it means `jhol fmt` formats exactly the
//! language `jhol-vm` runs.
//!
//! Output style follows Prettier's defaults (2-space indent, 80-column width,
//! semicolons, double quotes, trailing commas in multi-line collections).

use std::fmt::Write as _;

use crate::ast::*;
use crate::parser;
use crate::value::f64_to_js_string;

const WIDTH: usize = 80;
const INDENT: usize = 2;

pub fn format_source(src: &str, name: &str) -> Result<String, String> {
    format_source_with_config(src, name, 80, 2, false)
}

pub fn format_source_with_config(
    src: &str,
    name: &str,
    width: usize,
    indent: usize,
    use_tabs: bool,
) -> Result<String, String> {
    let prog = parser::parse_program(src).map_err(|e| e)?;
    let mut p = Printer::with_config(width, indent, use_tabs);
    p.program(&prog).map_err(|e| format!("{}: {}", name, e))?;
    if !p.out.is_empty() && !p.out.ends_with('\n') {
        p.out.push('\n');
    }
    let _ = name;
    Ok(p.out)
}

struct Printer {
    out: String,
    depth: usize,
    /// Remaining space on the current line, tracked so call/array/object
    /// literals can be collapsed when they fit.
    col: usize,
    prev_was_comment: bool,
    width: usize,
    indent: usize,
    use_tabs: bool,
}

// ── precedence ladder ────────────────────────────────────────────────────
// Higher binds tighter. Mirrors the ECMAScript grammar so parentheses the AST
// discarded can be re-inserted exactly where the language needs them.

const P_SEQ: u8 = 1;
const P_YIELD: u8 = 2;
const P_ASSIGN: u8 = 3;
const P_COND: u8 = 4;
const P_NULLISH: u8 = 5;
const P_OR: u8 = 6;
const P_AND: u8 = 7;
const P_BITOR: u8 = 8;
const P_BITXOR: u8 = 9;
const P_BITAND: u8 = 10;
const P_EQ: u8 = 11;
const P_REL: u8 = 12;
const P_SHIFT: u8 = 13;
const P_ADD: u8 = 14;
const P_MUL: u8 = 15;
const P_EXP: u8 = 16;
const P_UNARY: u8 = 17;
const P_POSTFIX: u8 = 18;
const P_CALL: u8 = 20;
const P_MEMBER: u8 = 21;
const P_PRIMARY: u8 = 30;

fn bin_prec(op: BinOp) -> u8 {
    match op {
        BinOp::Add | BinOp::Sub => P_ADD,
        BinOp::Mul | BinOp::Div | BinOp::Mod => P_MUL,
        BinOp::Pow => P_EXP,
        BinOp::Lt | BinOp::Gt | BinOp::Le | BinOp::Ge | BinOp::In | BinOp::InstanceOf => P_REL,
        BinOp::EqEq | BinOp::NotEq | BinOp::StrictEq | BinOp::StrictNotEq => P_EQ,
        BinOp::BitAnd => P_BITAND,
        BinOp::BitOr => P_BITOR,
        BinOp::BitXor => P_BITXOR,
        BinOp::Shl | BinOp::Shr | BinOp::UShr => P_SHIFT,
    }
}

fn log_prec(op: LogicalOp) -> u8 {
    match op {
        LogicalOp::And => P_AND,
        LogicalOp::Or => P_OR,
        LogicalOp::Nullish => P_NULLISH,
    }
}

fn prec(e: &Expr) -> u8 {
    match e {
        Expr::Seq(_) => P_SEQ,
        Expr::Yield(..) => P_YIELD,
        // Object/function/class literals sit at assignment level: they need
        // parens when used as a callee, member base or postfix target.
        Expr::Assign(..)
        | Expr::Arrow(_)
        | Expr::Func(_)
        | Expr::Class(_)
        | Expr::Object(_) => P_ASSIGN,
        Expr::Cond(..) => P_COND,
        Expr::Logical(op, ..) => log_prec(*op),
        Expr::Binary(op, ..) => bin_prec(*op),
        Expr::Unary(..) | Expr::Update(true, ..) => P_UNARY,
        Expr::Update(false, ..) => P_POSTFIX,
        Expr::Call { .. } | Expr::New(..) => P_CALL,
        Expr::Member { .. } | Expr::TaggedTemplate { .. } => P_MEMBER,
        Expr::OptionalChain(inner) => prec(inner),
        _ => P_PRIMARY,
    }
}

fn assign_op_str(op: AssignOp) -> &'static str {
    match op {
        AssignOp::Assign => "=",
        AssignOp::AddAssign => "+=",
        AssignOp::SubAssign => "-=",
        AssignOp::MulAssign => "*=",
        AssignOp::DivAssign => "/=",
        AssignOp::ModAssign => "%=",
        AssignOp::PowAssign => "**=",
        AssignOp::AndAssign => "&&=",
        AssignOp::OrAssign => "||=",
        AssignOp::NullishAssign => "??=",
        AssignOp::ShlAssign => "<<=",
        AssignOp::ShrAssign => ">>=",
        AssignOp::UShrAssign => ">>>=",
        AssignOp::BitAndAssign => "&=",
        AssignOp::BitOrAssign => "|=",
        AssignOp::BitXorAssign => "^=",
    }
}

impl Printer {
    fn new() -> Self {
        Printer {
            out: String::new(),
            depth: 0,
            col: 0,
            prev_was_comment: false,
            width: WIDTH,
            indent: INDENT,
            use_tabs: false,
        }
    }

    fn with_config(width: usize, indent: usize, use_tabs: bool) -> Self {
        Printer {
            out: String::new(),
            depth: 0,
            col: 0,
            prev_was_comment: false,
            width,
            indent,
            use_tabs,
        }
    }

    fn nl(&mut self) {
        self.out.push('\n');
        self.col = 0;
    }

    /// Ensure the output ends with exactly one separating space.
    fn gap_before(&mut self) {
        if self.out.is_empty() {
            return;
        }
        let last = self.out.chars().last().unwrap();
        if last != ' ' && last != '\n' {
            self.out.push(' ');
            self.col += 1;
        }
    }

    /// True when nothing has been written to the current line yet.
    fn at_line_start(&self) -> bool {
        self.col == 0 || self.out.ends_with('\n')
    }

    fn ind(&mut self) {
        self.out.push_str(&" ".repeat(self.depth * INDENT));
        self.col += self.depth * INDENT;
    }

    fn sp(&mut self) {
        if self.col > 0 && !self.out.ends_with(' ') && !self.out.ends_with('\n') {
            self.out.push(' ');
            self.col += 1;
        }
    }

    fn put(&mut self, s: &str) {
        self.out.push_str(s);
        self.col += s.len();
    }

    fn line(&mut self, s: &str) {
        self.ind();
        self.put(s);
        self.nl();
    }

    // ---------------- statements ----------------

    fn program(&mut self, prog: &Func) -> Result<(), String> {
        // Top-level: no indent, one statement per line, blank lines collapsed.
        self.depth = 0;
        for (i, s) in prog.body.iter().enumerate() {
            if i > 0 && !self.out.ends_with('\n') {
                self.nl();
            }
            self.stmt(s)?;
        }
        Ok(())
    }

    fn block(&mut self, body: &[Stmt]) -> Result<(), String> {
        if body.is_empty() {
            return Ok(());
        }
        self.nl();
        for (i, s) in body.iter().enumerate() {
            // Every terminating statement already ends a line; only add the
            // separator when the previous statement left us mid-line.
            if i > 0 && !self.out.ends_with('\n') {
                self.nl();
            }
            self.stmt(s)?;
        }
        Ok(())
    }

    fn stmt(&mut self, s: &Stmt) -> Result<(), String> {
        // Inline bodies (`if (x) break;`) arrive mid-line; indenting there
        // would pad the middle of the statement.
        // Comments position themselves (a trailing one re-attaches to the
        // previous line), so they must not be pre-indented here.
        if !matches!(s, Stmt::Empty | Stmt::Comment { .. }) && self.at_line_start() {
            self.ind();
        }
        match s {
            Stmt::Comment { text, trailing } => {
                if *trailing {
                    // It rode on the line the previous statement just wrote:
                    // pull that newline back and sit on the same line.
                    if self.out.ends_with('\n') {
                        self.out.pop();
                        self.col = self
                            .out
                            .rfind('\n')
                            .map(|i| self.out.len() - i - 1)
                            .unwrap_or(self.out.len());
                    }
                    self.gap_before();
                    self.put(text);
                } else {
                    self.ind();
                    self.put(text);
                }
                self.nl();
            }
            Stmt::Empty => {}
            Stmt::Raw(text) => {
                self.put(text.trim_start_matches(' '));
                self.nl();
            }
            Stmt::Expr(e) => {
                self.expr_stmt(e)?;
                self.semi();
            }
            Stmt::Var(kind, decls) => {
                let kw = match kind {
                    VarKind::Var => "var ",
                    VarKind::Let => "let ",
                    VarKind::Const => "const ",
                };
                self.put(kw);
                for (i, (t, init)) in decls.iter().enumerate() {
                    if i > 0 {
                        self.put(", ");
                    }
                    self.target(t)?;
                    if let Some(e) = init {
                        self.put(" = ");
                        self.expr(e)?;
                    }
                }
                self.semi();
            }
            Stmt::Block(body) => {
                self.put("{");
                self.depth += 1;
                self.block(body)?;
                self.close_brace();
                self.nl();
            }
            Stmt::If(c, a, b) => {
                self.put("if (");
                self.expr(c)?;
                self.put(") ");
                self.body_after_header(a)?;
                if let Some(b) = b {
                    // `else` stays on the closing brace's line: `} else if`.
                    self.chain_kw("else ");
                    self.body_after_header(b)?;
                }
            }
            Stmt::While(c, body) => {
                self.put("while (");
                self.expr(c)?;
                self.put(") ");
                self.body_after_header(body)?;
            }
            Stmt::DoWhile(body, c) => {
                self.put("do ");
                self.stmt_inline(body)?;
                // `} while (cond);` stays on the closing brace's line.
                self.chain_kw("while (");
                self.expr(c)?;
                self.put(")");
                self.semi();
            }
            Stmt::For(init, test, update, body) => {
                self.put("for (");
                // Clauses print without their own terminator: the header
                // supplies the `;` separators itself.
                if let Some(i) = init.as_deref() {
                    match i {
                        Stmt::Var(kind, decls) => {
                            let kw = match kind {
                                VarKind::Var => "var ",
                                VarKind::Let => "let ",
                                VarKind::Const => "const ",
                            };
                            self.put(kw);
                            for (n, (t, init_e)) in decls.iter().enumerate() {
                                if n > 0 {
                                    self.put(", ");
                                }
                                self.target(t)?;
                                if let Some(e) = init_e {
                                    self.put(" = ");
                                    self.expr(e)?;
                                }
                            }
                        }
                        Stmt::Expr(e) => self.expr(e)?,
                        Stmt::Comment { text, .. } => self.put(text),
                        other => self.stmt_inline(other)?,
                    }
                }
                self.put(";");
                if let Some(t) = test.as_ref() {
                    self.put(" ");
                    self.expr_at(t, P_ASSIGN)?;
                }
                self.put(";");
                if let Some(u) = update.as_ref() {
                    self.put(" ");
                    self.expr_at(u, P_ASSIGN)?;
                }
                self.put(") ");
                self.body_after_header(body)?;
            }
            Stmt::ForInOf { kind, decl, expr, body } => {
                let conj = match kind {
                    ForKind::In => " in ",
                    ForKind::Of | ForKind::AwaitOf => " of ",
                };
                let kw = match decl {
                    Some((VarKind::Var, _)) => "var ",
                    Some((VarKind::Let, _)) => "let ",
                    Some((VarKind::Const, _)) => "const ",
                    None => "",
                };
                if matches!(kind, ForKind::AwaitOf) {
                    self.put("for await (");
                } else {
                    self.put("for (");
                }
                if let Some((k, t)) = decl {
                    self.put(kw);
                    self.target(t)?;
                    self.put(conj);
                }
                self.expr(expr)?;
                self.put(") ");
                self.stmt_inline(body)?;
            }
            Stmt::Return(e) => {
                self.put("return");
                if let Some(e) = e {
                    self.sp();
                    self.expr(e)?;
                }
                self.semi();
            }
            Stmt::Break(l) => {
                self.put("break");
                if let Some(l) = l {
                    self.sp();
                    self.put(l);
                }
                self.semi();
            }
            Stmt::Continue(l) => {
                self.put("continue");
                if let Some(l) = l {
                    self.sp();
                    self.put(l);
                }
                self.semi();
            }
            Stmt::Throw(e) => {
                self.put("throw ");
                self.expr(e)?;
                self.semi();
            }
            Stmt::Try(body, catch, finally) => {
                self.put("try ");
                self.stmt_inline(body)?;
                if let Some((param, cbody)) = catch {
                    self.chain_kw("catch ");
                    if !matches!(param, Target::Simple(n) if n.is_empty()) {
                        self.put("(");
                        self.target(param)?;
                        self.put(") ");
                    }
                    self.stmt_inline(cbody)?;
                }
                if let Some(f) = finally {
                    self.chain_kw("finally ");
                    self.stmt_inline(f)?;
                }
            }
            Stmt::Func(f) => self.func(f)?,
            Stmt::Class(c) => self.class_def(c)?,
            Stmt::Labeled(name, inner) => {
                self.put(name);
                self.put(": ");
                self.stmt_inline(inner)?;
            }
            Stmt::Switch(disc, cases) => {
                self.put("switch (");
                self.expr(disc)?;
                self.put(") {");
                self.depth += 1;
                for (test, body) in cases {
                    if !self.out.ends_with('\n') {
                        self.nl();
                    }
                    self.ind();
                    match test {
                        Some(t) => {
                            self.put("case ");
                            self.expr(t)?;
                            self.put(":");
                        }
                        None => self.put("default:"),
                    }
                    self.depth += 1;
                    self.block(body)?;
                    self.depth -= 1;
                }
                self.depth -= 1;
                if !self.out.ends_with('\n') {
                    self.nl();
                }
                self.ind();
                self.put("}");
                self.nl();
            }
        }
        Ok(())
    }

    /// A statement in a position where a block-suffixed form reads better
    /// (`if (x) do();`), falling back to a braced block.
    fn stmt_inline(&mut self, s: &Stmt) -> Result<(), String> {
        match s {
            // `else if` chains onto one line instead of nesting a block.
            Stmt::If(..) | Stmt::For(..) | Stmt::While(..) | Stmt::ForInOf { .. }
            | Stmt::DoWhile(..) => self.stmt(s),
            Stmt::Empty => Ok(()),
            Stmt::Block(body) => {
                self.put("{");
                self.depth += 1;
                self.block(body)?;
                // The brace always starts a line; whoever chains after it
                // (`else`, `catch`) pulls the newline back via `chain_kw`.
                self.close_brace();
                Ok(())
            }
            Stmt::Expr(e) => {
                self.expr(e)?;
                self.semi();
                Ok(())
            }
            _ => self.stmt(s),
        }
    }

    /// Close a block: the brace goes on its own line, but only when something
    /// is not waiting to chain onto it (`} else`, `} while`). Inline contexts
    /// skip this so they can append.
    fn close_brace(&mut self) {
        if self.out.ends_with('{') {
            // Empty body: `{}` inline (Prettier style), not a broken line.
            self.depth -= 1;
            self.put("}");
            return;
        }
        if !self.out.ends_with('\n') && !self.out.ends_with('}') {
            self.nl();
        } else if self.out.ends_with('}') && !self.at_line_start() {
            self.nl();
        }
        self.depth -= 1;
        self.ind();
        self.put("}");
    }

    /// Put a keyword that chains onto the block just closed — `} else`,
    /// `} catch`, `} while`. A block's closing brace always starts its own
    /// line, so this pulls the newline back when there is one; when the body
    /// was a single statement it ended mid-line and only needs a space.
    fn chain_kw(&mut self, kw: &str) {
        // Only a block's `}` chains onto the same line — `} else`, `} catch`.
        // After a non-block statement the keyword always starts its own line,
        // which is what bun and Prettier both do for `if (x) y();\nelse z();`.
        let after_brace = self.out.ends_with('}');
        if self.out.ends_with('\n') {
            if !after_brace {
                self.ind();
                self.put(kw);
                return;
            }
            let start = self.out.rfind('\n').map(|i| i + 1).unwrap_or(0);
            let line_len = self.out[start..].chars().count();
            if line_len + kw.chars().count() <= WIDTH {
                self.out.pop();
                self.col = line_len.saturating_sub(1);
            } else {
                self.ind();
                self.put(kw);
                return;
            }
        } else if !after_brace {
            self.nl();
            self.ind();
            self.put(kw);
            return;
        }
        self.gap_before();
        self.put(kw);
    }

    /// Body of a header statement (`for (...) <stmt>`, `while (...) <stmt>`): a
    /// block stays on the header line, a one-liner stays there if it fits, and
    /// anything wider breaks onto its own indented line.
    fn body_after_header(&mut self, body: &Stmt) -> Result<(), String> {
        if matches!(body, Stmt::Block(_) | Stmt::If(..) | Stmt::For(..) | Stmt::While(..) | Stmt::ForInOf { .. } | Stmt::DoWhile(..)) {
            return self.stmt_inline(body);
        }
        let mut probe = Printer { out: String::new(), depth: self.depth + 1, col: 0, prev_was_comment: false, width: self.width, indent: self.indent, use_tabs: self.use_tabs };
        probe.stmt_inline(body)?;
        // The probe indents for its own line; the placement here supplies the
        // indentation, so the leading run is dropped.
        let text = probe
            .out
            .trim_end_matches('\n')
            .trim_start()
            .to_string();
        if self.col + text.chars().count() <= WIDTH {
            self.out.push_str(&text);
            self.col += text.chars().count();
        } else {
            // Drop the space after `)` so the header line does not trail, and
            // indent one level past the statement itself (the header sits at
            // the statement's own indent, the continuation is nested).
            if self.out.ends_with(' ') || self.out.ends_with('\t') {
                self.out.pop();
                self.col = self.col.saturating_sub(1);
            }
            self.nl();
            let pad = (self.depth + 1) * INDENT;
            self.out.push_str(&" ".repeat(pad));
            self.col = pad;
            self.out.push_str(&text);
            self.col = pad + text.chars().count();
        }
        Ok(())
    }

    fn semi(&mut self) {
        if !self.out.ends_with('\n') {
            self.put(";");
            self.nl();
        }
    }

    fn func(&mut self, f: &Func) -> Result<(), String> {
        // `async function name(...)` / `function name(...)`. The async modifier
        // precedes the keyword; it is not part of the parameter list.
        if f.is_async {
            self.put("async ");
        }
        self.put("function");
        if f.is_generator {
            self.put("*");
        }
        // Always separate: `function grade()` needs the space before the name,
        // and an anonymous `function ()` needs it before the parameter list.
        self.sp();
        if let Some(n) = &f.name {
            self.put(n);
        }
        self.params(&f.params)?;
        self.sp();
        self.put("{");
        self.depth += 1;
        match &f.expr_body {
            Some(e) => {
                if f.is_async {
                    self.ind();
                    self.put("return ");
                } else {
                    self.ind();
                }
                self.expr(e)?;
                self.semi();
            }
            None => self.block(&f.body)?,
        }
        self.close_brace();
        Ok(())
    }

    fn arrow(&mut self, f: &Func) -> Result<(), String> {
        if f.is_async {
            self.put("async ");
        }
        self.params(&f.params)?;
        self.put(" => ");
        match &f.expr_body {
            Some(e) => {
                // `x => ({ ... })`: a bare object literal is a block here.
                self.expr_at(e, P_COND + 1)?;
            }
            None => {
                self.put("{");
                self.depth += 1;
                self.block(&f.body)?;
                self.close_brace();
            }
        }
        Ok(())
    }

    fn params(&mut self, params: &[Param]) -> Result<(), String> {
        self.put("(");
        for (i, p) in params.iter().enumerate() {
            if i > 0 {
                self.put(", ");
            }
            if p.rest {
                self.put("...");
            }
            self.target(&p.target)?;
            if let Some(d) = &p.default {
                self.put(" = ");
                self.expr(d)?;
            }
        }
        self.put(")");
        Ok(())
    }

    fn class_def(&mut self, c: &ClassDef) -> Result<(), String> {
        self.put("class");
        if let Some(n) = &c.name {
            self.sp();
            self.put(n);
        }
        if let Some(s) = &c.superclass {
            self.put(" extends ");
            self.expr(s)?;
        }
        self.put(" {");
        self.depth += 1;
        for m in &c.members {
            if !self.out.ends_with('\n') {
                self.nl();
            }
            self.ind();
            match &m.kind {
                ClassMemberKind::Method(f, is_static) => {
                    if *is_static {
                        self.put("static ");
                    }
                    // The parser encodes getter/setter as a marker in Func.name.
                    let mut prefix = String::new();
                    let mut shown: Option<String> = None;
                    if let Some(n) = &f.name {
                        if let Some(r) = n.strip_prefix("\u{1}g:") {
                            prefix.push_str("get ");
                            shown = Some(r.to_string());
                        } else if let Some(r) = n.strip_prefix("\u{1}s:") {
                            prefix.push_str("set ");
                            shown = Some(r.to_string());
                        }
                    }
                    self.put(&prefix);
                    if f.is_async {
                        self.put("async ");
                    }
                    if f.is_generator {
                        self.put("*");
                    }
                    match shown {
                        Some(n) => self.put(&n),
                        None => match &m.key {
                            ClassKey::Name(n) => {
                                if is_ident(n) {
                                    self.put(n);
                                } else {
                                    self.put(&quote(n));
                                }
                            }
                            ClassKey::Private(n) => self.put(&format!("#{}", n)),
                            ClassKey::Computed(e) => {
                                self.put("[");
                                self.expr(e)?;
                                self.put("]");
                            }
                        },
                    }
                    self.params(&f.params)?;
                    self.sp();
                    self.put("{");
                    self.depth += 1;
                    self.block(&f.body)?;
                    self.close_brace();
                }
                ClassMemberKind::Field(e) | ClassMemberKind::StaticField(e) => {
                    match &m.key {
                        ClassKey::Computed(ce) => {
                            self.put("[");
                            self.expr(ce)?;
                            self.put("]");
                        }
                        key => self.put(&class_key_text(key)),
                    }
                    self.put(" = ");
                    self.expr(e)?;
                    self.semi();
                }
            }
        }
        self.depth -= 1;
        if !self.out.ends_with('\n') {
            self.nl();
        }
        self.ind();
        self.put("}");
        Ok(())
    }

    fn target(&mut self, t: &Target) -> Result<(), String> {
        match t {
            Target::Simple(n) => self.put(n),
            Target::Member(e) => self.expr(e)?,
            Target::Array(items) => {
                self.put("[");
                let mut first = true;
                for it in items {
                    if !first {
                        self.put(", ");
                    }
                    first = false;
                    match it {
                        Some(t) => self.target(t)?,
                        None => {}
                    }
                }
                self.put("]");
            }
            Target::Object(fields) => {
                self.put("{ ");
                for (i, f) in fields.iter().enumerate() {
                    if i > 0 {
                        self.put(", ");
                    }
                    if f.rest {
                        self.put("...");
                        if let Some(t) = &f.target {
                            self.target(t)?;
                        }
                        continue;
                    }
                    match &f.key {
                        MemberKey::Computed(e) => {
                            self.put("[");
                            self.expr(e)?;
                            self.put("]");
                        }
                        MemberKey::Dot(n) => {
                            let needs_quote = !is_ident(n);
                            if needs_quote {
                                self.put("\"");
                                self.put(n);
                                self.put("\"");
                            } else {
                                self.put(n);
                            }
                        }
                    }
                    if let Some(t) = &f.target {
                        self.put(": ");
                        self.target(t)?;
                    }
                    if let Some(d) = &f.default {
                        self.put(" = ");
                        self.expr(d)?;
                    }
                }
                self.put(" }");
            }
            Target::WithDefault(t, d) => {
                self.target(t)?;
                self.put(" = ");
                self.expr(d)?;
            }
            Target::Rest { target, .. } => {
                self.put("...");
                self.target(target)?;
            }
        }
        Ok(())
    }

    // ---------------- expressions ----------------
    //
    // The AST discards parentheses, so the printer re-inserts them from the
    // ECMAScript precedence ladder. `expr_at(e, ctx)` parenthesizes whenever
    // `prec(e) < ctx`, where `ctx` is the minimum precedence the surrounding
    // slot allows.

    /// Print `e` in a slot that accepts an AssignmentExpression (argument,
    /// array element, object value, `return`, assignment right-hand side…).
    fn expr(&mut self, e: &Expr) -> Result<(), String> {
        self.expr_at(e, P_ASSIGN)
    }

    fn expr_at(&mut self, e: &Expr, ctx: u8) -> Result<(), String> {
        if prec(e) < ctx {
            self.put("(");
            self.raw_expr(e)?;
            self.put(")");
        } else {
            self.raw_expr(e)?;
        }
        Ok(())
    }

    /// Expression statement: a leading `{`, `function` or `class` would be read
    /// as a block or declaration, so wrap it.
    fn expr_stmt(&mut self, e: &Expr) -> Result<(), String> {
        let ambiguous = matches!(e, Expr::Object(_) | Expr::Func(_) | Expr::Class(_));
        if ambiguous {
            self.put("(");
            self.raw_expr(e)?;
            self.put(")");
        } else {
            self.raw_expr(e)?;
        }
        Ok(())
    }

    /// Break a method-call chain link-by-link when it does not fit:
    ///
    /// ```js
    /// const adults = people
    ///   .filter((p) => p.age >= 30)
    ///   .map((p) => p.name.toUpperCase());
    /// ```
    ///
    /// A chain is a nesting of `member call`s — `arr.map(f).filter(g)` is
    /// `Call(Member(Call(Member(arr, map), filter), ...))` — so walking the
    /// receivers collects the links. Returns the base plus one entry per link.
    fn chain_links(e: &Expr) -> Option<(&Expr, Vec<(&MemberKey, bool, &[Expr], bool)>)> {
        let mut links: Vec<(&MemberKey, bool, &[Expr], bool)> = Vec::new();
        let mut cur = e;
        loop {
            match cur {
                Expr::Call { callee, args, optional } => match callee.as_ref() {
                    Expr::Member { obj, key, optional: om } => {
                        links.push((key, *om, args.as_slice(), *optional));
                        cur = obj.as_ref();
                    }
                    _ => break,
                },
                _ => break,
            }
        }
        if links.is_empty() {
            return None;
        }
        links.reverse();
        Some((cur, links))
    }

    /// Base of a member/call: parenthesize whatever the grammar requires
    /// there — numeric literals always (`5.toString()` fails to lex), and
    /// anything below member precedence.
    fn callee_base(&mut self, obj: &Expr) -> Result<(), String> {
        if matches!(obj, Expr::Num(_)) {
            self.put("(");
            self.raw_expr(obj)?;
            self.put(")");
            return Ok(());
        }
        self.expr_at(obj, P_CALL)
    }

    /// One link: `.name(args)` or `?.name(args)`.
    fn chain_link(&mut self, key: &MemberKey, om: bool, args: &[Expr], call_opt: bool) -> Result<(), String> {
        match key {
            MemberKey::Dot(n) => {
                if om {
                    self.put("?.");
                } else {
                    self.put(".");
                }
                self.put(n);
            }
            MemberKey::Computed(e) => {
                // Computed access takes no dot — `fns[0]`, never `fns.[0]`;
                // only the optional form carries one: `fns?.[0]`.
                if om {
                    self.put("?.");
                }
                self.put("[");
                self.expr(e)?;
                self.put("]");
            }
        }
        if call_opt {
            self.put("?.");
        }
        self.arg_list(args)
    }

    fn raw_expr(&mut self, e: &Expr) -> Result<(), String> {
        match e {
            Expr::Num(n) => self.put(&f64_to_js_string(*n)),
            Expr::BigInt(n) => {
                let _ = write!(self.out, "{}n", n);
                self.col += 4;
            }
            Expr::Str(v) => self.put(&quote(v)),
            Expr::Str16(v) => self.put(&quote_utf16(v)),
            Expr::Bool(b) => self.put(if *b { "true" } else { "false" }),
            Expr::Null => self.put("null"),
            Expr::Undefined => self.put("undefined"),
            Expr::Ident(n) => self.put(n),
            Expr::This => self.put("this"),
            Expr::Super => self.put("super"),
            Expr::NewTarget => self.put("new.target"),
            Expr::Regex(b, f) => self.put(&format!("/{}/{}", b, f)),
            Expr::Template(parts) => self.template(parts)?,
            Expr::TaggedTemplate { tag, parts } => {
                self.expr_at(tag, P_MEMBER)?;
                self.template(parts)?;
            }
            Expr::Array(items) => self.array_lit(items)?,
            Expr::Object(props) => self.object_lit(props)?,
            Expr::Func(f) => self.func(f)?,
            Expr::Arrow(f) => self.arrow(f)?,
            Expr::Class(c) => self.class_def(c)?,
            Expr::Unary(op, inner) => {
                self.put(unary_str(*op));
                // `-(-x)` / `+(+x)` must not run together: `--x` would
                // re-parse as a decrement.
                let glues = matches!(op, UnOp::Neg | UnOp::Plus)
                    && matches!(
                        inner.as_ref(),
                        Expr::Unary(UnOp::Neg | UnOp::Plus, _) | Expr::Update(true, ..)
                    );
                if glues || prec(inner) < P_UNARY {
                    self.put("(");
                    self.raw_expr(inner)?;
                    self.put(")");
                } else {
                    self.raw_expr(inner)?;
                }
            }
            Expr::Update(prefix, uop, inner) => {
                let op_str = match uop {
                    UpdOp::Inc => "++",
                    UpdOp::Dec => "--",
                };
                if *prefix {
                    self.put(op_str);
                    self.expr_at(inner, P_CALL)?;
                } else {
                    self.expr_at(inner, P_CALL)?;
                    self.put(op_str);
                }
            }
            Expr::Binary(op, l, r) => {
                let p = bin_prec(*op);
                // `**` is right-associative; everything else left-associative.
                let (lc, rc) = if *op == BinOp::Pow { (p + 1, p) } else { (p, p + 1) };

                // Flatten the left spine of same-precedence operators — `a + b
                // + c + d` — so a chain that overflows the print width breaks
                // with each operand on its own line instead of silently
                // exceeding it.
                let mut operands: Vec<&Expr> = Vec::new();
                let mut ops: Vec<BinOp> = Vec::new();
                let mut cur: &Expr = e;
                while let Expr::Binary(o, left, right) = cur {
                    if bin_prec(*o) != p {
                        break;
                    }
                    ops.push(*o);
                    operands.push(right.as_ref());
                    cur = left.as_ref();
                }
                operands.push(cur);
                operands.reverse();
                ops.reverse();

                let mut probe = Printer {
                    out: String::new(),
                    depth: self.depth,
                    // Seed at the real column: the decision must be identical
                    // whether this runs inside a probe (argument list) or in
                    // the real output, or the two disagree and produce a
                    // different shape than the one that was measured.
                    col: self.col,
                    prev_was_comment: false,
                    width: self.width,
                    indent: self.indent,
                    use_tabs: self.use_tabs,
                };
                let mut ok = true;
                for (i, od) in operands.iter().enumerate() {
                    if i > 0 {
                        probe.put(" ");
                        probe.put(binary_str(ops[i - 1]));
                        probe.put(" ");
                    }
                    // Leftmost operand sits on the left of the whole chain, the
                    // rest sit on the right — the parentheses each needs follow
                    // from that, exactly as the unflattened form decided.
                    if probe.expr_at(*od, if i == 0 { lc } else { rc }).is_err() {
                        ok = false;
                    }
                }
                let ls = self.out.rfind('\n').map(|i| i + 1).unwrap_or(0);
                let line_rest = &self.out[ls..];
                let line_indent = line_rest.len() - line_rest.trim_start().len();
                if ok && !probe.out.contains('\n') && probe.col <= WIDTH {
                    let text = probe.out;
                    self.out.push_str(&text);
                    self.col += text.chars().count();
                    return Ok(());
                }
                // Broken form: the operator trails the line it belongs to.
                let pad = line_indent + INDENT;
                for (i, od) in operands.iter().enumerate() {
                    if i > 0 {
                        self.put(" ");
                        self.put(binary_str(ops[i - 1]));
                        self.nl();
                        self.out.push_str(&" ".repeat(pad));
                        self.col = pad;
                    }
                    self.expr_at(*od, if i == 0 { lc } else { rc })?;
                }
            }
            Expr::Logical(op, l, r) => {
                // Mixing `??` with `||`/`&&` without parens is a syntax error,
                // so that pairing gets parens regardless of ladder position.
                let child_ctx = |c: &Expr, right: bool| -> u8 {
                    if *op == LogicalOp::Nullish
                        && !matches!(c, Expr::Logical(LogicalOp::Nullish, ..))
                    {
                        P_AND + 1
                    } else {
                        let p = log_prec(*op);
                        if right {
                            p + 1
                        } else {
                            p
                        }
                    }
                };
                let lctx = child_ctx(l, false);
                let rctx = child_ctx(r, true);
                self.expr_at(l, lctx)?;
                self.sp();
                self.put(match op {
                    LogicalOp::And => "&&",
                    LogicalOp::Or => "||",
                    LogicalOp::Nullish => "??",
                });
                self.sp();
                self.expr_at(r, rctx)?;
            }
            Expr::Assign(op, t, v) => {
                self.target(t)?;
                self.sp();
                self.put(assign_op_str(*op));
                self.sp();
                self.expr_at(v, P_ASSIGN)?;
            }
            Expr::Cond(c, a, b) => {
                // The condition slot excludes assignments, sequences and
                // ternaries; a nested ternary in the middle branch is parenthesized
                // so the grouping stays obvious.
                self.expr_at(c, P_COND + 1)?;
                self.sp();
                self.put("? ");
                let actx = if matches!(a.as_ref(), Expr::Cond(..)) {
                    P_COND + 1
                } else {
                    P_ASSIGN
                };
                self.expr_at(a, actx)?;
                self.sp();
                self.put(": ");
                self.expr_at(b, P_ASSIGN)?;
            }
            Expr::Call { callee, args, optional } => {
                // A method chain that does not fit breaks before each link
                // instead of exploding its argument list.
                let chain = Self::chain_links(e).filter(|(_, l)| l.len() >= 2);
                if let Some((base, links)) = chain {
                    let mut probe = Printer { out: String::new(), depth: self.depth, col: 0, prev_was_comment: false, width: self.width, indent: self.indent, use_tabs: self.use_tabs };
                    let mut fits = true;
                    if probe.callee_base(base).is_err() {
                        fits = false;
                    }
                    for (key, om, as_, co) in &links {
                        if probe.chain_link(key, *om, as_, *co).is_err() {
                            fits = false;
                        }
                    }
                    if fits && probe.col + self.col <= WIDTH {
                        let text = probe.out;
                        self.out.push_str(&text);
                        self.col += text.chars().count();
                        return Ok(());
                    }
                    self.callee_base(base)?;
                    // One level past the line the chain starts on: a chain that
                    // begins mid-statement (`const x = arr`) still nests from
                    // the statement's own indent, not from the column it
                    // happened to reach.
                    let ls = self.out.rfind('\n').map(|i| i + 1).unwrap_or(0);
                    let line_rest = &self.out[ls..];
                    let line_indent = line_rest.len() - line_rest.trim_start().len();
                    let pad = line_indent + INDENT;
                    for (key, om, as_, co) in &links {
                        self.nl();
                        self.out.push_str(&" ".repeat(pad));
                        self.col = pad;
                        self.chain_link(key, *om, as_, *co)?;
                    }
                    return Ok(());
                }
                self.expr_at(callee, P_CALL)?;
                if *optional {
                    self.put("?.");
                }
                self.arg_list(args)?;
            }
            Expr::New(callee, args) => {
                self.put("new ");
                // `new`'s callee is a MemberExpression: a call needs parens.
                self.expr_at(callee, P_MEMBER)?;
                self.arg_list(args)?;
            }
            Expr::Member { obj, key, optional } => {
                self.callee_base(obj)?;
                match key {
                    MemberKey::Dot(n) => {
                        if *optional {
                            self.put("?.");
                        } else {
                            self.put(".");
                        }
                        self.put(n);
                    }
                    MemberKey::Computed(inner) => {
                        // Computed access never takes a dot: `a[0]`, `a?.[0]`.
                        if *optional {
                            self.put("?.");
                        }
                        self.put("[");
                        self.expr_at(inner, P_ASSIGN)?;
                        self.put("]");
                    }
                }
            }
            Expr::Seq(items) => {
                for (i, it) in items.iter().enumerate() {
                    if i > 0 {
                        self.put(", ");
                    }
                    self.expr_at(it, P_ASSIGN)?;
                }
            }
            Expr::Spread(inner) => {
                self.put("...");
                self.expr_at(inner, P_ASSIGN)?;
            }
            Expr::Yield(inner, delegate) => {
                self.put("yield");
                if *delegate {
                    self.put("*");
                }
                if let Some(inner) = inner {
                    self.sp();
                    self.expr_at(inner, P_ASSIGN)?;
                }
            }
            Expr::OptionalChain(inner) => self.raw_expr(inner)?,
        }
        Ok(())
    }

    fn template(&mut self, parts: &[TplPart]) -> Result<(), String> {
        self.put("`");
        for p in parts {
            match p {
                TplPart::Str(s) => self.put(s),
                TplPart::Raw(r) => {
                    self.put("${");
                    self.expr(&raw_as_expr(r))?;
                    self.put("}");
                }
                TplPart::Expr(e) => {
                    self.put("${");
                    self.expr(e)?;
                    self.put("}");
                }
            }
        }
        self.put("`");
        Ok(())
    }

    fn arg_list(&mut self, args: &[Expr]) -> Result<(), String> {
        if args.is_empty() {
            self.put("()");
            return Ok(());
        }
        // A lone object/array argument breaks *itself*, keeping `push({` and
        // `});` on their anchors:
        //
        //   list.push({
        //     id: i,
        //   });
        //
        // Breaking the argument list instead would strand `{ ... }` on its own
        // line, which is never what a call like this wants to say.
        if args.len() == 1 && matches!(args[0], Expr::Object(_) | Expr::Array(_)) {
            self.put("(");
            self.expr(&args[0])?;
            self.put(")");
            return Ok(());
        }
        // Try one line; break per argument when it would overflow.
        let mut probe = self.col;
        let mut buf = String::new();
        let mut ok = true;
        let mut old = std::mem::take(&mut self.out);
        let saved_col = self.col;
        self.out = String::new();
        self.col = 0;
        self.put("(");
        for (i, a) in args.iter().enumerate() {
            if i > 0 {
                self.put(", ");
            }
            if self.expr(a).is_err() {
                ok = false;
            }
        }
        self.put(")");
        if self.col + probe > WIDTH || !ok {
            // Multi-line form.
            // Seed each argument at the column it will actually occupy, so
            // nested printers do not see room the real line lacks (the
            // argument's own trailing comma included).
            // +1 reserves the comma the argument list appends after it.
            let seed = self.depth * INDENT + INDENT + 1;
            let inner: Vec<String> = args
                .iter()
                .map(|a| {
                    let mut p2 = Printer { out: String::new(), depth: self.depth + 1, col: seed, prev_was_comment: false, width: self.width, indent: self.indent, use_tabs: self.use_tabs };
                    let _ = p2.expr(a);
                    p2.out
                })
                .collect();
            let cont = " ".repeat(self.depth * INDENT + INDENT);
            old.push('(');
            old.push('\n');
            for (i, line) in inner.iter().enumerate() {
                old.push_str(&cont);
                old.push_str(line);
                if i + 1 < inner.len() {
                    old.push(',');
                } else {
                    out_trailing_comma(&mut old, true);
                }
                old.push('\n');
            }
            let close = " ".repeat(self.depth * INDENT);
            old.push_str(&close);
            old.push(')');
            self.out = old;
            self.col = probe + close.len() + 1;
            return Ok(());
        }
        buf = std::mem::replace(&mut self.out, old);
        self.col = saved_col + buf.chars().count();
        self.out.push_str(&buf);
        Ok(())
    }

    fn array_lit(&mut self, items: &[Option<Expr>]) -> Result<(), String> {
        if items.is_empty() {
            self.put("[]");
            return Ok(());
        }
        // Nested collections always break; scalar lists try to fit on one line.
        let nested = items
            .iter()
            .flatten()
            .any(|e| matches!(e, Expr::Array(_) | Expr::Object(_) | Expr::Func(_) | Expr::Arrow(_)));
        if !nested
            && fits_inline(
                self.col,
                self.depth,
                self.width,
                self.indent,
                self.use_tabs,
                |p| {

            p.put("[");
            for (i, it) in items.iter().enumerate() {
                if i > 0 {
                    p.put(", ");
                }
                match it {
                    Some(e) => {
                        if p.expr(e).is_err() {
                            return false;
                        }
                    }
                    None => p.put(""),
                }
            }
            p.put("]");
            true
        }) {
            self.put("[");
            for (i, it) in items.iter().enumerate() {
                if i > 0 {
                    self.put(", ");
                }
                if let Some(e) = it {
                    self.expr(e)?;
                }
            }
            self.put("]");
            return Ok(());
        }
        self.put("[");
        self.depth += 1;
        for it in items {
            self.nl();
            self.ind();
            if let Some(e) = it {
                self.expr(e)?;
            }
            any_comma(&mut self.out);
        }
        self.depth -= 1;
        self.nl();
        self.ind();
        self.put("]");
        Ok(())
    }

    fn object_lit(&mut self, props: &[ObjProp]) -> Result<(), String> {
        if props.is_empty() {
            self.put("{}");
            return Ok(());
        }
        // A literal with only data properties collapses onto one line when it
        // fits the print width — `{ a: 1, b: { c: 2, d: [3, 4] } }` — the way
        // bun and Prettier print them. Methods and spread force a break.
        // Data properties only: a function, class or block-bodied arrow always
        // spans lines, so the literal has to stay expanded.
        let collapsible = props.iter().all(|p| match p {
            ObjProp::Shorthand(_) => true,
            ObjProp::Init(_, v) => !matches!(
                **v,
                Expr::Func(_) | Expr::Class(_) | Expr::Arrow(_)
            ),
            _ => false,
        });
        if collapsible {
            // The probe starts at the REAL column, so a nested literal inside
            // it makes the same fits/doesn't-fit decision it will make while
            // the real output is being written.
            let base = self.col;
            let mut probe = Printer { out: String::new(), depth: self.depth, col: base, prev_was_comment: false, width: self.width, indent: self.indent, use_tabs: self.use_tabs };
            probe.put("{ ");
            let mut ok = true;
            for (i, pr) in props.iter().enumerate() {
                if i > 0 {
                    probe.put(", ");
                }
                if probe.object_prop(pr).is_err() {
                    ok = false;
                }
            }
            probe.put(" }");
            // "Fits" means one line: a probe that broke internally reports only
            // its last line's column, which is misleadingly short.
            if ok && !probe.out.contains('\n') && probe.col <= WIDTH {
                self.put(&probe.out);
                return Ok(());
            }
        }
        self.put("{");
        self.depth += 1;
        for p in props {
            self.nl();
            self.ind();
            self.object_prop(p)?;
            any_comma(&mut self.out);
        }
        self.depth -= 1;
        self.nl();
        self.ind();
        self.put("}");
        Ok(())
    }

    fn object_prop(&mut self, p: &ObjProp) -> Result<(), String> {
        match p {
            ObjProp::Init(key, val) => {
                self.member_key(key)?;
                self.put(": ");
                self.expr(val)?;
            }
            ObjProp::Shorthand(n) => self.put(n),
            ObjProp::Spread(e) => {
                self.put("...");
                self.expr(e)?;
            }
            ObjProp::Method { key, func, kind } => {
                match kind {
                    MethodKind::Get => self.put("get "),
                    MethodKind::Set => self.put("set "),
                    MethodKind::Method => {}
                }
                if func.is_async {
                    self.put("async ");
                }
                if func.is_generator {
                    self.put("*");
                }
                self.member_key(key)?;
                self.params(&func.params)?;
                self.sp();
                self.put("{");
                self.depth += 1;
                self.block(&func.body)?;
                self.close_brace();
            }
        }
        Ok(())
    }

    fn member_key(&mut self, k: &MemberKey) -> Result<(), String> {
        match k {
            MemberKey::Dot(n) => {
                if is_ident(n) {
                    self.put(n);
                } else {
                    self.put(&quote(n));
                }
            }
            MemberKey::Computed(e) => {
                self.put("[");
                self.expr(e)?;
                self.put("]");
            }
        }
        Ok(())
    }
}

// ---------------------------------------------------------------------------
// small helpers
// ---------------------------------------------------------------------------

fn any_comma(out: &mut String) {
    let trimmed = out.trim_end_matches(|c| c == ' ' || c == '\n');
    let _ = trimmed;
    // Prettier's default trailingComma is "all": add one in multi-line.
    if !out.is_empty() {
        out.push(',');
    }
}

fn out_trailing_comma(out: &mut String, _yes: bool) {
    out.push(',');
}

/// Render `f` against a scratch printer starting at `base` columns and report
/// whether the result stays within the print width.
fn fits_inline<F: FnOnce(&mut Printer) -> bool>(
    base: usize,
    depth: usize,
    width: usize,
    indent: usize,
    use_tabs: bool,
    f: F,
) -> bool {
    let mut probe = Printer {
        out: String::new(),
        depth,
        col: 0,
        prev_was_comment: false,
        width,
        indent,
        use_tabs,
    };
    if !f(&mut probe) {
        return false;
    }
    // Same rule as the object probe: collapsing requires the whole thing to be
    // ONE line, so a newline anywhere means it does not fit.
    !probe.out.contains('\n') && probe.col + base <= width
}

fn try_flat(p: &mut Printer, items: &[Option<Expr>]) -> Option<String> {
    // Only literals of scalars collapse; anything nested keeps its own shape.
    if items.iter().flatten().any(|e| matches!(e, Expr::Array(_) | Expr::Object(_))) {
        return None;
    }
    let mut probe = Printer { out: String::new(), depth: 0, col: 0, prev_was_comment: false, width: WIDTH, indent: INDENT, use_tabs: false };
    for (i, it) in items.iter().enumerate() {
        if i > 0 {
            probe.put(", ");
        }
        match it {
            Some(e) => {
                if probe.expr(e).is_err() {
                    return None;
                }
            }
            None => probe.put(""),
        }
    }
    if probe.col + p.col > WIDTH {
        return None;
    }
    Some(probe.out)
}

/// Render an expression back to source. Used by the parser to round-trip
/// template holes inside `export`/`import` statements, which are passed through
/// verbatim rather than compiled.
pub fn expr_source(e: &Expr) -> String {
    let mut p = Printer { out: String::new(), depth: 0, col: 0, prev_was_comment: false, width: WIDTH, indent: INDENT, use_tabs: false };
    match p.expr(e) {
        Ok(()) => p.out,
        Err(_) => String::new(),
    }
}

/// Template holes arrive from the lexer as raw source; re-parse so the printer
/// sees a real expression (the same trick the compiler uses).
fn raw_as_expr(r: &str) -> Expr {
    match parser::parse_program(r) {
        Ok(f) => match f.body.as_slice() {
            [Stmt::Expr(e)] => e.clone(),
            _ => Expr::Undefined,
        },
        Err(_) => Expr::Ident(r.to_string()),
    }
}

pub fn quote(s: &str) -> String {
    // Choose the delimiter that requires fewer escapes — `quote: "q"` keeps
    // its double quotes by switching to single quotes. Ties go to `"`.
    let dq = s.matches('"').count();
    let sq = s.matches('\'').count();
    let q = if dq > sq { '\'' } else { '"' };
    let mut out = String::with_capacity(s.len() + 2);
    out.push(q);
    for c in s.chars() {
        match c {
            c if c == q => {
                out.push('\\');
                out.push(c);
            }
            '\\' => out.push_str("\\\\"),
            '\n' => out.push_str("\\n"),
            '\r' => out.push_str("\\r"),
            '\t' => out.push_str("\\t"),
            c => out.push(c),
        }
    }
    out.push(q);
    out
}

pub fn is_ident(s: &str) -> bool {
    let mut ch = s.chars();
    match ch.next() {
        Some(c) if c.is_alphabetic() || c == '_' || c == '$' => {}
        _ => return false,
    }
    ch.all(|c| c.is_alphanumeric() || c == '_' || c == '$')
}

fn class_key_text(k: &ClassKey) -> String {
    match k {
        ClassKey::Name(n) => n.clone(),
        ClassKey::Private(n) => format!("#{}", n),
        ClassKey::Computed(_) => String::new(),
    }
}

fn unary_str(op: UnOp) -> &'static str {
    match op {
        UnOp::Await => "await ",
        UnOp::Neg => "-",
        UnOp::Plus => "+",
        UnOp::Not => "!",
        UnOp::BitNot => "~",
        UnOp::TypeOf => "typeof ",
        UnOp::Void => "void ",
        UnOp::Delete => "delete ",
    }
}

fn binary_str(op: BinOp) -> &'static str {
    match op {
        BinOp::Add => "+",
        BinOp::Sub => "-",
        BinOp::Mul => "*",
        BinOp::Div => "/",
        BinOp::Mod => "%",
        BinOp::Pow => "**",
        BinOp::Lt => "<",
        BinOp::Gt => ">",
        BinOp::Le => "<=",
        BinOp::Ge => ">=",
        BinOp::EqEq => "==",
        BinOp::NotEq => "!=",
        BinOp::StrictEq => "===",
        BinOp::StrictNotEq => "!==",
        BinOp::BitAnd => "&",
        BinOp::BitOr => "|",
        BinOp::BitXor => "^",
        BinOp::Shl => "<<",
        BinOp::Shr => ">>",
        BinOp::UShr => ">>>",
        BinOp::In => "in",
        BinOp::InstanceOf => "instanceof",
    }
}

// Preserve unpaired code units when re-emitting a parsed string literal.
pub(crate) fn quote_utf16(units: &[u16]) -> String {
    use std::fmt::Write;
    let mut out=String::from("\"");
    for u in units { let _=write!(out,"\\u{:04x}",u); }
    out.push('"'); out
}
